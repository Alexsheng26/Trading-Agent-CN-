# ============================================================
# Trading-Agent-CN 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿把真实 Key 提交到仓库
# ============================================================

# ---------- 运行环境 ----------
# 可选值：dev | prod
APP_ENV=dev
LOG_LEVEL=INFO
# 允许跨域的前端地址，逗号分隔。
# 注意：默认架构下浏览器只访问前端（:3000），由 Next 在服务端代理到后端，
# 浏览器不会直接请求 :8000，所以**手机访问也不需要改这里**。
# 只有当你让浏览器/其他客户端直连 :8000 时，才需要把那个来源加进来。
CORS_ORIGINS=http://localhost:3000

# ---------- 数据库 ----------
# 下面这个是给"原生运行"（make dev / uvicorn 直接起）用的相对路径。
# 用 Docker 跑的话这一项会被忽略 —— 容器里固定用命名卷中的绝对路径，
# 见 docker-compose.yml。要在 Docker 下换 Postgres，设 DOCKER_DATABASE_URL。
DATABASE_URL=sqlite+aiosqlite:///./data/trading_agent.db
# 生产可换 PostgreSQL（原生运行时）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_agent

# ---------- A股数据源 ----------
# 按优先级排序，前面的不可用时自动降级到后面
# 可选值：akshare | xueqiu | sina | tushare | mock
#   akshare —— 东方财富，字段最全（主机 push2*.eastmoney.com）
#   xueqiu  —— 雪球，单只行情一个请求带齐价格/估值/市值（主机 xueqiu.com）
#   sina    —— 新浪，日线与大盘指数（主机 *.sina.com.cn）
#   tushare —— 正式 API，需免费注册拿 token（主机 api.tushare.pro）
# 中间三个和东方财富**没有任何共用主机**。这很关键：push2.eastmoney.com
# 在部分网络下不可达（代理软件、公司网络、个别运营商线路），
# 这时行情和 K 线会自动降级到雪球/新浪，而不是整体没数据。
#
# ⚠️ **不要把 mock 放进来。** mock 是程序生成的假行情，而这个工具会输出
# 具体的买卖点位 —— 假数据被当成真行情，后果很严重。真踩过这个坑：
# 全市场快照接口每次超时，于是每次静默降级到 mock，界面上出现
# "华宝股份 299.42"，AI 还给了一整套止盈止损，看起来跟真的一样。
# 取不到真数据就该报错，界面会明确显示取数失败，这比编一个数字安全得多。
# 只有想离线看界面长什么样时，才单独写 DATA_PROVIDER_ORDER=mock。
DATA_PROVIDER_ORDER=akshare,xueqiu,sina,tushare
# Tushare Pro token（https://tushare.pro 注册获取），不填则 tushare 适配器自动跳过
TUSHARE_TOKEN=
# 行情缓存秒数（盘中建议 30-60，盘后可调大）
QUOTE_CACHE_TTL=60
# 日线/财报/新闻缓存秒数
HISTORY_CACHE_TTL=3600
# 单个数据源单次调用的超时（秒）。超了就降级到下一个源。
# AKShare 底层是爬第三方站点，慢或挂是常态，必须时间盒住 ——
# 否则一个卡住的接口会让页面一直转圈。
# 注意：这个值只管交互接口（单只行情、日线、新闻等，都是单个请求，很快）。
# 全市场列表那种天生要一分多钟的接口走 SYMBOL_INDEX_TIMEOUT，不受这里限制。
PROVIDER_TIMEOUT=12
# 启动后在后台建立"全市场代码-名称目录"，按名称搜索（如"茅台"）靠它。
# 建好之后搜索是纯本地查询，毫秒级返回，数据源事后挂掉也照样能搜。
# 设 false 则每次按名称搜索都现场去问数据源（慢，且数据源一挂就搜不到）。
SYMBOL_INDEX_AUTOREFRESH=true
# 目录多久算过期（小时）。A股每天有新股上市，一天一次足够。
SYMBOL_INDEX_TTL_HOURS=24
# 建目录时给数据源的超时（秒）。AKShare 的全市场列表接口按每页 100 条翻页，
# 5400 多只要翻 54 页、每页之间还 sleep 0.5-1.5 秒，单次就要 60-90 秒 ——
# 所以它只在后台跑，并且用这个大超时，不能用上面那个给交互接口准备的 12 秒。
SYMBOL_INDEX_TIMEOUT=240
# 让 akshare 的请求走浏览器 TLS 指纹（curl_cffi，本来就是 akshare 的依赖）。
# 东方财富会按 TLS 握手特征拦掉普通 Python requests，表现是
# "Remote end closed connection without response"（注意：是被掐断，不是超时）——
# 而 akshare 里唯一用 curl_cffi 的个股新闻接口照样能通，一个通、其余全挂
# 就是这个原因。开着它能绕过这类拦截。遇到怪问题想排除变量时再设 false。
AKSHARE_BROWSER_TRANSPORT=true
# 模拟哪个浏览器：chrome / safari / edge ...
AKSHARE_IMPERSONATE=chrome
# 雪球行情接口需要登录凭证，不填则雪球源会跳过（行情自动降级到后面的源）。
# 取法：浏览器打开 xueqiu.com，F12 → 应用/Application → Cookie，
# 复制 xq_a_token 的值粘到这里。它会过期，失效后重新取一次。
XUEQIU_TOKEN=

# ---------- LLM ----------
# 可选值：anthropic | openai_compat | echo
#   anthropic     —— Claude（默认，效果最好）
#   openai_compat —— DeepSeek / 通义千问 / Kimi 等 OpenAI 兼容接口（国内直连友好）
#   echo          —— 离线桩，不联网不花钱，用于开发调试与跑测试
LLM_PROVIDER=echo
# 离线桩的输出间隔（秒）。0.03 左右能看到打字机效果，方便确认流式链路通了；
# 设 0 则瞬间出结果。只对 echo 生效。
ECHO_DELAY=0.03

# Claude
ANTHROPIC_API_KEY=
# 主决策模型（交易员 / 风控）
ANTHROPIC_MODEL=claude-opus-5
# 分析师模型，留空则与主模型一致；想省钱可设 claude-sonnet-5
ANTHROPIC_ANALYST_MODEL=
# 推理投入：low | medium | high | xhigh | max
LLM_EFFORT=high
# 模型因安全策略拒答时自动换模型跑完（投研类内容偶尔会被拦，建议开着）
ANTHROPIC_REFUSAL_FALLBACK=true

# OpenAI 兼容接口。改用它时记得把上面的 LLM_PROVIDER 设成 openai_compat。
#   DeepSeek   https://api.deepseek.com/v1                        deepseek-chat
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi       https://api.moonshot.cn/v1                         moonshot-v1-32k
# 注意：兼容接口没有提示缓存，一次分析 10 次调用的输入 token 都按全价计，
# 成本结构和 Claude 那条路不同（但 DeepSeek 单价低很多，总体仍便宜）。
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=deepseek-chat

# ---------- 智能体流水线 ----------
# 多空辩论轮数（每轮多头、空头各发言一次）
DEBATE_ROUNDS=2
# 单次分析的总超时（秒）
ANALYSIS_TIMEOUT=600

# ---------- 前端 ----------
# 前端访问后端的地址（前端构建时注入）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
